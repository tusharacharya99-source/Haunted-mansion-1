<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Haunted Mansion Adventure</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#080d16;color:#fff}
header{display:flex;justify-content:space-between;align-items:center;padding:22px 8%;background:#101827;border-bottom:1px solid #29364b}
.logo{font-size:23px;font-weight:bold;color:#9cf6d5}
nav a{color:#ddd;text-decoration:none;margin-left:22px}
.hero{min-height:82vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:50px 20px;background:radial-gradient(ellipse at center,#26364a 0%,#101827 48%,#080d16 100%)}
.content{max-width:800px}
.tag{display:inline-block;padding:9px 16px;border:1px solid #70d9b7;border-radius:30px;color:#9cf6d5;margin-bottom:25px}
h1{font-size:clamp(40px,8vw,78px);line-height:1.05;margin-bottom:22px}
h1 span{color:#9cf6d5}
p{font-size:18px;line-height:1.7;color:#c3ccda}
.buttons{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:30px}
button{padding:15px 28px;border:0;border-radius:8px;font-size:16px;font-weight:bold;cursor:pointer}
.play{background:#9cf6d5;color:#08130f}
.learn{background:#202d40;color:white;border:1px solid #44536a}
button:hover{transform:translateY(-2px);filter:brightness(1.1)}
section{padding:65px 8%;text-align:center}
h2{font-size:34px;margin-bottom:18px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:20px;margin-top:32px}
.card{background:#111b2a;border:1px solid #29364b;padding:28px 22px;border-radius:14px}
.card .emoji{font-size:40px;margin-bottom:15px}
.card h3{margin-bottom:12px}
.card p{font-size:15px}
footer{text-align:center;padding:25px;background:#101827;color:#9ba9bc}
@media(max-width:600px){header{padding:18px 5%}nav a{margin-left:10px;font-size:13px}.logo{font-size:17px}section{padding:45px 6%}}
</style>
</head>
<body>
<header>
  <div class="logo">🏚️ Mansion Adventure</div>
  <nav>
    <a href="#features">Features</a>
    <a href="#about">About</a>
  </nav>
</header>

<main>
  <div class="hero">
    <div class="content">
      <div class="tag">🎮 YOUR NEXT ADVENTURE STARTS HERE</div>
      <h1>Explore the <span>Mystery.</span><br>Own the Adventure.</h1>
      <p>Enter a mysterious mansion, explore hidden places, discover secrets and challenge yourself. Your adventure awaits!</p>
      <div class="buttons">
        <button class="play" onclick="playGame()">▶ PLAY NOW</button>
        <button class="learn" onclick="document.getElementById('features').scrollIntoView({behavior:'smooth'})">EXPLORE FEATURES ↓</button>
      </div>
    </div>
  </div>

  <section id="features">
    <h2>What Awaits You?</h2>
    <p>Explore, discover and make your own adventure.</p>
    <div class="cards">
      <div class="card">
        <div class="emoji">🏚️</div>
        <h3>Explore the Mansion</h3>
        <p>Discover rooms, corridors and mysterious locations.</p>
      </div>
      <div class="card">
        <div class="emoji">🔎</div>
        <h3>Find Hidden Secrets</h3>
        <p>Search for clues and uncover hidden surprises.</p>
      </div>
      <div class="card">
        <div class="emoji">🗝️</div>
        <h3>Unlock New Areas</h3>
        <p>Find keys and discover where your adventure leads.</p>
      </div>
    </div>
  </section>

  <section id="about">
    <h2>Ready, Adventurer?</h2>
    <p>Your journey begins when you press Play. Explore at your own pace and see what you can discover.</p>
    <div class="buttons">
      <button class="play" onclick="playGame()">▶ START ADVENTURE</button>
    </div>
  </section>
</main>

<footer>🏚️ Haunted Mansion Adventure · Let the adventure begin!</footer>

<script>
const GAME_URL = https://script.google.com/macros/s/AKfycbyFnb8aLiG4yr2E59EuVbZ6-DRwIhhxRw90DWYUZs8i/dev

function playGame(){
  if(!GAME_URL.startsWith("https://")){
    alert("Bro, first paste your published Google Apps Script web app URL in GAME_URL.");
    return;
  }
  window.open(GAME_URL,"_blank");
}
</script>
</body>
</html>
